{
  "name": "daywise-travel-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ops": "node --env-file-if-exists=.env --import tsx scripts/operations.ts",
    "check:release": "node --env-file-if-exists=.env scripts/release-check.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "fastify": "^5.12.5",
    "firebase": "12.4.0",
    "firebase-admin": "^13.10.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/google.maps": "^3.66.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@firebase/app": "0.14.4",
    "@firebase/app-compat": "0.5.4",
    "@grpc/grpc-js": "^1.14.6",
    "uuid": "^11.1.1"
  }
}
