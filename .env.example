# API settings (read by npm run dev:api; never prefix server secrets with VITE_)
API_AUTH_MODE=local
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# This is the browser website origin, not the API port. Local auth also accepts
# localhost on this same scheme/port. Firebase/production require an exact match.
# For a custom preview port, set WEB_PORT for both npm commands and update
# WEB_ORIGIN, or omit WEB_ORIGIN to derive it from WEB_PORT (default 5173).
PROVIDER_DAILY_LIMIT=600

# Local deterministic commands by default; no API calls or secret required.
ASSISTANT_MODE=local
AI_DAILY_LIMIT=100
# Optional operator diagnostics token (32+ characters); never a VITE_ variable.
# In local mode a separate OS-protected credential is generated automatically.
# OPERATIONS_TOKEN=server-only-operator-token
# Optional structured planning and intent interpretation. Choose/pin a model after evaluating it.
# ASSISTANT_MODE=openai
# OPENAI_API_KEY=server-only-key
# OPENAI_MODEL=your-evaluated-model-id
# Gemini alternative, server-only (never VITE_GEMINI_API_KEY):
# ASSISTANT_MODE=gemini
# GEMINI_API_KEY=server-only-key
# GEMINI_MODEL=your-evaluated-supported-model-id

# Future Firebase connection. No cloud resources are created by the application.
# API_AUTH_MODE=firebase
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside-repository/service-account.json

# Optional emulator settings; forbidden when NODE_ENV=production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Public Firebase browser configuration, NOT a service-account credential.
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_API_KEY=public-firebase-web-config-key
# VITE_FIREBASE_APP_ID=your-web-app-id
# VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Paid server credentials remain outside the frontend build.
GOOGLE_ROUTES_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_TIME_ZONE_API_KEY=
# CHECKED_CATALOG_PATH=catalogs/private/checked-cities.json

# This public map key MUST have HTTP referrer + Maps JavaScript API restrictions.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# The browser key must be distinct from all server keys. Shared values are
# rejected before frontend bundling. Blank values leave unrelated features usable.

# Normal UI/API use only real providers, even during local development.
# See location-setup.md for required APIs, billing, restrictions and retention.
# Fixture regressions run only in the isolated Playwright harness.
# Normal dev/API startup cannot enable fixture locations.
